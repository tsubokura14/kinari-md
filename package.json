{
  "name": "kinari-md",
  "version": "0.0.0",
  "private": true,
  "description": "シリーズのアプリで共有する、Markdown の変換と本文の見た目",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsubokura14/kinari-md.git"
  },
  "exports": {
    "./markdown": "./src/markdown/index.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "next dev sample",
    "build": "next build sample",
    "start": "next start sample",
    "test": "vitest run",
    "lint": "eslint && node scripts/check-tokens.mjs",
    "typecheck": "next typegen sample && tsc --noEmit",
    "test:visual": "node scripts/playwright-docker.mjs --update-snapshots=none",
    "screenshots": "node scripts/playwright-docker.mjs --update-snapshots=changed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,jsx,css,json}\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "next": "16.4.6",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  }
}
